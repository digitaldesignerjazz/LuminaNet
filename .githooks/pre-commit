#!/usr/bin/env bash
# LuminaNet pre-commit — Form und keine Secrets.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

fail() { echo "pre-commit: $1" >&2; exit 1; }

# Gestagede Dateien (Added/Copied/Modified/Renamed)
mapfile -t STAGED < <(git diff --cached --name-only --diff-filter=ACMR || true)
[[ ${#STAGED[@]} -eq 0 ]] && exit 0

# Secrets und private Zustände
SECRET_PAT='(^|/)·?env(·|$)|\.pem$|\.key$|\.p12$|(^|/)id_rsa|(^|/)secrets/|_state\.md$'
for f in "${STAGED[@]}"; do
  if echo "$f" | grep -Eq '\.env($|\.)|\.pem$|\.key$|\.p12$|(^|/)id_rsa|(^|/)secrets/|_state\.md$'; then
    fail "Secret-verdächtige Datei nicht committen: $f"
  fi
done

# Keine offensichtlichen Schlüssel im Patch
if git diff --cached -U0 | grep -Eiq '-----BEGIN (RSA |OPENSSH |EC )?PRIVATE KEY-----'; then
  fail "Privater Schlüssel im Diff. Commit abgebrochen."
fi

# JSON der Beispiele muss parsebar sein
for f in "${STAGED[@]}"; do
  case "$f" in
    schema/examples/*/*.json|schema/*.json)
      python3 -m json.tool "$f" >/dev/null \
        || fail "ungültiges JSON: $f"
      ;;
  esac
done

# Schema-Kante, wenn Schemas, Beispiele oder Validator betroffen
NEED_VALIDATE=0
for f in "${STAGED[@]}"; do
  case "$f" in
    schema/*|tools/validate.py)
      NEED_VALIDATE=1
      ;;
  esac
done

if [[ "$NEED_VALIDATE" -eq 1 ]]; then
  if python3 -c "import jsonschema" >/dev/null 2>&1; then
    python3 tools/validate.py || fail "validate.py — Kante gebrochen"
  else
    echo "pre-commit: jsonschema fehlt, überspringe validate.py (python3-jsonschema installieren)"
  fi
fi

exit 0
