# NetBird – Nexus / LuminaOS
# Cloud-Control-Plane: https://app.netbird.io
#
# Client installieren:
#   curl -fsSL https://pkgs.netbird.io/install.sh | sh
#
# Erstes Gerät (Browser-Login):
#   netbird up
#
# Weitere Geräte (Setup-Key aus dem Dashboard):
#   export NETBIRD_SETUP_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#   netbird up --setup-key "$NETBIRD_SETUP_KEY"
#
# Optional self-hosted Management (nicht nötig für Cloud):
#   export NETBIRD_MGMT=https://netbird.example.com

NETBIRD_SETUP_KEY=
NETBIRD_MGMT=
